{
  "env": {
    "browser": true,
    "es2022": true,
    "jest": true
  },
  "extends": ["standard"],
  "parserOptions": {
    "ecmaVersion": 2022,
    "sourceType": "module"
  },
  "rules": {
    "semi": ["error", "always"],
    "quotes": ["error", "single"],
    "no-unused-vars": ["warn", {"argsIgnorePattern": "^_"}]
  },
  "ignorePatterns": ["vendor/", "node_modules/"]
}
