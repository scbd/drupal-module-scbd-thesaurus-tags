{
  "name": "scbd/drupal-module-scbd-thesaurus-tags",
  "description": "SCBD field module tests",
  "type": "project",
  "require-dev": {
    "phpunit/phpunit": "^10.5",
    "squizlabs/php_codesniffer": "^3.9",
    "phpunit/php-code-coverage": "^10.1"
  },
  "autoload": {
    "files": ["scbd_field.install"]
  },
  "suggest": {
    "ext-pcov": "For faster code coverage (optional, otherwise Xdebug can be used)",
    "ext-xdebug": "Alternative coverage driver when pcov isn't available"
  },
  "config": {
    "sort-packages": true
  },
  "scripts": {
  "test": "phpunit -c phpunit.xml.dist --no-coverage",
    "coverage": "phpunit -c phpunit.xml.dist --coverage-text --coverage-clover build/coverage-php/clover.xml",
    "lint:php": "phpcs --standard=PSR12 src tests/php",
    "lint:php-fix": "phpcbf --standard=PSR12 src tests/php"
  }
}
