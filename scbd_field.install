<?php

use Drupal\Core\Database\Connection;
use Drupal\Core\Field\FieldStorageDefinitionInterface;

/**
 * Implements hook_requirements().
 *
 * Validates bioland module version when bioland.settings config exists.
 */
function scbd_field_requirements($phase) {
  $requirements = [];

  if ($phase === 'install' || $phase === 'runtime' || $phase === 'update') {
    // Check if bioland.settings config exists
    $bioland_config = \Drupal::config('bioland.settings');
    $config_data = $bioland_config->getRawData();
    
    if (!empty($config_data)) {
      // bioland.settings exists, so we need to verify the module version
      $module_handler = \Drupal::moduleHandler();
      
      if (!$module_handler->moduleExists('bioland')) {
        $requirements['scbd_field_bioland'] = [
          'title' => t('SCBD Field - Bioland Module'),
          'description' => t('The bioland.settings configuration exists but the bioland module is not installed. Please install the bioland module version 1.0.4 or higher.'),
          'severity' => REQUIREMENT_ERROR,
        ];
      } else {
        // Module exists, check version
        $bioland_info = \Drupal::service('extension.list.module')->getExtensionInfo('bioland');
        $version = $bioland_info['version'] ?? '';
        
        // Parse version (format: 1.0.4 or 8.x-1.0.4)
        if (preg_match('/(\d+)\.(\d+)\.(\d+)/', $version, $matches)) {
          $major = (int) $matches[1];
          $minor = (int) $matches[2];
          $patch = (int) $matches[3];
          
          // Check if version is at least 1.0.4
          $version_sufficient = ($major > 1) || 
                               ($major === 1 && $minor > 0) || 
                               ($major === 1 && $minor === 0 && $patch >= 4);
          
          if (!$version_sufficient) {
            $requirements['scbd_field_bioland'] = [
              'title' => t('SCBD Field - Bioland Module'),
              'description' => t('The bioland module version @version is installed, but version 1.0.4 or higher is required.', ['@version' => $version]),
              'severity' => REQUIREMENT_ERROR,
            ];
          } else {
            $requirements['scbd_field_bioland'] = [
              'title' => t('SCBD Field - Bioland Module'),
              'value' => t('Version @version', ['@version' => $version]),
              'severity' => REQUIREMENT_OK,
            ];
          }
        } else {
          $requirements['scbd_field_bioland'] = [
            'title' => t('SCBD Field - Bioland Module'),
            'description' => t('Unable to determine bioland module version. Version 1.0.4 or higher is required.'),
            'severity' => REQUIREMENT_ERROR,
          ];
        }
      }
    }
  }

  return $requirements;
}

/**
 * Consolidate delta values into comma-separated format for all scbd_field_thesaurus fields.
 */
function _scbd_field_consolidate_deltas_for_all(): void {
  $connection = \Drupal::database();
  $schema = $connection->schema();
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $field_storages = $storage->loadByProperties(['type' => 'scbd_field_thesaurus']);

  if (!$field_storages) {
    return;
  }

  foreach ($field_storages as $fs) {
    // Skip if cardinality is already 1 - no migration needed.
    if ((int) $fs->getCardinality() === 1) {
      continue;
    }

    $entity_type_id = $fs->getTargetEntityTypeId();
    $field_name = $fs->getName();

    $definition = \Drupal::entityTypeManager()->getDefinition($entity_type_id);
    $is_revisionable = method_exists($definition, 'isRevisionable') ? $definition->isRevisionable() : FALSE;

    $data_table = $entity_type_id . '__' . $field_name;
    $revision_table = $is_revisionable ? ($entity_type_id . '_revision__' . $field_name) : NULL;

    if ($schema->tableExists($data_table)) {
      _scbd_field_consolidate_deltas_in_table($connection, $data_table, $field_name, FALSE);
    }
    if ($revision_table && $schema->tableExists($revision_table)) {
      _scbd_field_consolidate_deltas_in_table($connection, $revision_table, $field_name, TRUE);
    }
  }
}

/**
 * Ensure cardinality is 1 for all scbd_field_thesaurus storages.
 */
function _scbd_field_ensure_cardinality_one(): void {
  $storage = \Drupal::entityTypeManager()->getStorage('field_storage_config');
  $field_storages = $storage->loadByProperties(['type' => 'scbd_field_thesaurus']);
  foreach ($field_storages as $fs) {
    if ((int) $fs->getCardinality() !== 1) {
      $fs->setCardinality(1);
      $fs->save();
    }
  }
}

/**
 * Consolidate deltas within a single field data table.
 *
 * For each entity/language/revision group, gather all delta rows and combine
 * their value and value2 columns into comma-separated strings stored in delta 0.
 * Delete all other delta rows for that group.
 *
 * @param \Drupal\Core\Database\Connection $connection
 * @param string $table
 * @param string $field_name
 * @param bool $has_revision_id
 */
function _scbd_field_consolidate_deltas_in_table(Connection $connection, string $table, string $field_name, bool $has_revision_id): void {
  // Drupal prefixes field columns with the field name.
  $value_column = $field_name . '_value';
  $value2_column = $field_name . '_value2';
  // Find all unique entity/lang/deleted[/revision] groups.
  $query = $connection->select($table, 't');
  $query->fields('t', ['entity_id', 'langcode', 'deleted']);
  if ($has_revision_id) {
    $query->addField('t', 'revision_id');
  }
  $query->distinct();

  $groups = $query->execute()->fetchAll();

  foreach ($groups as $group) {
    $keys = [
      'entity_id' => (int) $group->entity_id,
      'langcode' => $group->langcode,
      'deleted' => (int) $group->deleted,
    ];
    if ($has_revision_id) {
      $keys['revision_id'] = (int) $group->revision_id;
    }

    // Load all rows for this group ordered by delta.
    $sel = $connection->select($table, 't')
      ->fields('t')
      ->condition('entity_id', $keys['entity_id'])
      ->condition('langcode', $keys['langcode'])
      ->condition('deleted', $keys['deleted'])
      ->orderBy('delta', 'ASC');
    if ($has_revision_id) {
      $sel->condition('revision_id', $keys['revision_id']);
    }
    $result = $sel->execute();
    
    $rows = [];
    foreach ($result as $row) {
      $rows[] = $row;
    }
    
    if (!$rows) {
      continue;
    }

    // Collect all non-empty values from all deltas.
    $all_values = [];
    $all_values2 = [];
    
    foreach ($rows as $row) {
      $val = $row->{$value_column} ?? NULL;
      $val2 = $row->{$value2_column} ?? NULL;
      
      if ($val !== NULL && $val !== '') {
        $all_values[] = trim($val);
      }
      if ($val2 !== NULL && $val2 !== '') {
        $all_values2[] = trim($val2);
      }
    }

    // Create comma-separated strings.
    $consolidated_value = implode(',', $all_values);
    $consolidated_value2 = implode(',', $all_values2);

    // Update delta 0 with consolidated values.
    $upd = $connection->update($table)
      ->fields([
        $value_column => $consolidated_value ?: NULL,
        $value2_column => $consolidated_value2 ?: NULL,
      ])
      ->condition('entity_id', $keys['entity_id'])
      ->condition('langcode', $keys['langcode'])
      ->condition('deleted', $keys['deleted'])
      ->condition('delta', 0);
    if ($has_revision_id) {
      $upd->condition('revision_id', $keys['revision_id']);
    }
    $upd->execute();

    // Delete all other deltas (> 0) for this group.
    $del = $connection->delete($table)
      ->condition('entity_id', $keys['entity_id'])
      ->condition('langcode', $keys['langcode'])
      ->condition('deleted', $keys['deleted'])
      ->condition('delta', 0, '>');
    if ($has_revision_id) {
      $del->condition('revision_id', $keys['revision_id']);
    }
    $del->execute();
  }
}

/**
 * Remove stale scbd_field_simple_text formatter from entity view displays.
 *
 * This formatter was removed from the module, so we need to clean up any
 * entity_view_display configs that still reference it.
 *
 * @return int
 *   The number of display configurations that were updated.
 */
function _scbd_field_remove_stale_formatter(): int {
  $count = 0;
  $config_factory = \Drupal::configFactory();
  
  // Find all entity view display configurations.
  $display_configs = $config_factory->listAll('core.entity_view_display.');
  
  foreach ($display_configs as $config_name) {
    $config = $config_factory->getEditable($config_name);
    $content = $config->get('content');
    
    if (!is_array($content)) {
      continue;
    }
    
    $modified = FALSE;
    
    foreach ($content as $field_name => $field_config) {
      // Check if this field uses the removed formatter.
      if (isset($field_config['type']) && $field_config['type'] === 'scbd_field_simple_text') {
        // Replace with the default 'string' formatter which handles text fields.
        $content[$field_name]['type'] = 'string';
        // Clear any formatter-specific settings that may not apply.
        $content[$field_name]['settings'] = [];
        $modified = TRUE;
      }
    }
    
    if ($modified) {
      $config->set('content', $content);
      $config->save();
      $count++;
    }
  }
  
  return $count;
}

/**
 * Implements hook_install().
 */
function scbd_field_install() {
  // On fresh install, ensure cardinality is set to 1.
  _scbd_field_ensure_cardinality_one();

  // Remove any stale scbd_field_simple_text formatter references.
  _scbd_field_remove_stale_formatter();

  // Import provided translations (.po) bundled with the module, if locale
  // module is enabled. This ensures strings are available immediately.
  if (\Drupal::moduleHandler()->moduleExists('locale')) {
    /** @var \Drupal\locale\SourceStringStorageInterface $source_storage */
    // Rebuild locale cache to pick up .po files under translations/.
    \Drupal::service('locale.storage')->deleteConfiguration('scbd_field');
    // Queue import of translation files (core scans translations/ automatically
    // on cache rebuild / locale update). Force a string refresh.
    \Drupal::service('string_translation')->reset();
  }
}

/**
 * Update: Legacy - no longer needed (replaced by update 9004).
 */
function scbd_field_update_9001() {
  return t('Skipped - cardinality update moved to 9004.');
}

/**
 * Update: Legacy - no longer needed (replaced by update 9004).
 */
function scbd_field_update_9002() {
  return t('Skipped - delta consolidation moved to 9004.');
}

/**
 * Update: Refresh/import bundled translations after adding .po files.
 */
function scbd_field_update_9003() {
  if (\Drupal::moduleHandler()->moduleExists('locale')) {
    // Flush project to force re-scan of translations directory.
    if (function_exists('locale_translation_flush_projects')) {
      locale_translation_flush_projects();
    }
    // Refresh only this project's translations if API available.
    if (function_exists('locale_translation_refresh_projects')) {
      locale_translation_refresh_projects(['scbd_field']);
    }
    // Attempt automatic update/import.
    if (function_exists('locale_translation_update_projects')) {
      locale_translation_update_projects(['scbd_field']);
    }
    // Reset string translation cache so new strings are picked up immediately.
    \Drupal::service('string_translation')->reset();
  }
  return t('Refreshed translations for scbd_field.');
}

/**
 * Update: Consolidate delta values into comma-separated strings and set cardinality to 1.
 */
function scbd_field_update_9004() {
  _scbd_field_consolidate_deltas_for_all();
  _scbd_field_ensure_cardinality_one();
  return t('Consolidated delta values into comma-separated format and set cardinality to 1.');
}

/**
 * Update: Add domain configuration settings.
 */
function scbd_field_update_9005() {
  $config = \Drupal::configFactory()->getEditable('scbd_field.settings');
  
  // Set default domain order
  if (!$config->get('domain_order')) {
    $config->set('domain_order', [
      'gbfTargets',
      'nationalTargets7',
      'countries',
      'subjects',
      'sdgs',
    ]);
  }
  
  $config->save();
  
  return t('Added domain configuration settings with default values.');
}

/**
 * Update: Remove enabled_domains configuration (all domains now available).
 */
function scbd_field_update_9006() {
  $config = \Drupal::configFactory()->getEditable('scbd_field.settings');
  
  // Remove enabled_domains if it exists
  if ($config->get('enabled_domains') !== NULL) {
    $config->clear('enabled_domains');
    $config->save();
  }
  
  return t('Removed enabled_domains configuration - all domains are now available.');
}

/**
 * Update: Remove stale scbd_field_simple_text formatter from entity view displays.
 */
function scbd_field_update_9007() {
  $count = _scbd_field_remove_stale_formatter();
  return t('Removed @count stale scbd_field_simple_text formatter references from entity view displays.', ['@count' => $count]);
}

/**
 * Update: Add field_tags_value2 column if missing and clean up field storage config.
 */
function scbd_field_update_9008() {
  $messages = [];
  $connection = \Drupal::database();
  $schema = $connection->schema();

  // List of tables that should have field_tags_value2 column.
  $tables_to_check = [
    'comment__field_tags',
    'comment_revision__field_tags',
    'node__field_tags',
    'node_revision__field_tags',
  ];

  // Add field_tags_value2 column if it does not exist.
  foreach ($tables_to_check as $table) {
    if ($schema->tableExists($table) && !$schema->fieldExists($table, 'field_tags_value2')) {
      $schema->addField($table, 'field_tags_value2', [
        'type' => 'text',
        'size' => 'big',
        'not null' => FALSE,
        'description' => 'Secondary value for field_tags.',
      ]);
      $messages[] = t('Added field_tags_value2 column to @table.', ['@table' => $table]);
    }
  }

  // Clean up comment.field_tags field storage config if it exists.
  $field_storage = \Drupal\field\Entity\FieldStorageConfig::load('comment.field_tags');
  if ($field_storage) {
    // Remove any stale field_storage_submit property.
    if (isset($field_storage->field_storage_submit)) {
      unset($field_storage->field_storage_submit);
      $field_storage->save();
      $messages[] = t('Cleaned up comment.field_tags field storage configuration.');
    }
  }

  // Clean up node.field_tags field storage config if it exists.
  $node_field_storage = \Drupal\field\Entity\FieldStorageConfig::load('node.field_tags');
  if ($node_field_storage) {
    // Remove any stale field_storage_submit property.
    if (isset($node_field_storage->field_storage_submit)) {
      unset($node_field_storage->field_storage_submit);
      $node_field_storage->save();
      $messages[] = t('Cleaned up node.field_tags field storage configuration.');
    }
  }

  if (empty($messages)) {
    return t('No field_tags_value2 columns needed to be added or field storage cleanup needed.');
  }

  return implode(' ', $messages);
}
