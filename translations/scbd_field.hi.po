#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "डोमेन ऑर्डर"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "प्रदर्शन क्रम निर्दिष्ट करने के लिए प्रति पंक्ति एक डोमेन आईडी दर्ज करें। सभी सूचीबद्ध डोमेन उपलब्ध होंगे।"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "अमान्य डोमेन आईडी: @domain"

