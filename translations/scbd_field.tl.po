msgid "Global Biodiversity Framework Targets"
msgstr "Mga Target ng Global Biodiversity Framework"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Mga Target ng Pambansang Biodiversidad (na-filter ayon sa bansa)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Mga Layunin ng Napapanatiling"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Mga Bansa"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Mga Luhan/Paksa na Mga Paksa"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Mga Lugar na Tematikong Biosafety"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Mga Grupo ng Tematikong Lugar ng Biosafety"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Mga Rehiyong Heograpik"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Mga Uri ng Ecosystem"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Mode ng pag-debug"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Ipakita ang mga nakatagong patlang ng input para sa mga layunin ng pag-debug."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Mga Setting ng Awtomatikong Halaga"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "I-configure ang awtomatikong populasyon ng mga halaga ng patlang."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Huwag paganahin ang auto-add GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Kapag hindi naka-check (default), awtomatikong idadagdag ang GBF Target 17 sa mga site ng biosafety."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Huwag paganahin ang awtomatikong magdagdag"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Kapag hindi naka-check (default), awtomatikong idadagdag sa patlang ang mga bansa mula sa bioland.settings."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Pagsasaayos ng Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Ang lahat ng mga domain ay magagamit. I-configure ang kanilang order ng pagpapakita sa ibaba."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Magagamit na Mga Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Listahan ng sanggunian ng lahat ng mga key ng domain at ang kanilang mga pangalan ng display."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Pag-order ng Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Magpasok ng isang domain ID bawat linya upang tukuyin ang pagkakasunud-sunod ng display Magagamit ang lahat ng nakalistang domain."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Hindi wastong domain ID: @domain"

