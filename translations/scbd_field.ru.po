#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Автоматическая настройка значений"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Настройте автоматическое заполнение значений полей."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Отключить автоматическое добавление GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Если флажок не установлен (по умолчанию), GBF Target 17 будет автоматически добавлен на сайты биобезопасности."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Отключить автоматическое добавление стран"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Если флажок снят (по умолчанию), страны из bioland.settings будут автоматически добавлены в поле."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Конфигурация домена"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Доступны все домены. Настройте порядок их отображения ниже."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Доступные домены"

#: src/Form/ScbdFieldSettingsForm.php
