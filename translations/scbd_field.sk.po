#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Ciele globálneho rámca biodiverzity"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Národné ciele biodiverzity (filtrované podľa krajín)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Ciele trvalo udržateľného rozvoja"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "krajiny"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematické oblasti/Predmety"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Tematické oblasti biologickej bezpečnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Skupiny tematických oblastí biologickej bezpečnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografické regióny"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Typy ekosystémov"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Režim ladenia"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Zobraziť skryté vstupné polia na účely ladenia."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatické nastavenia hodnoty"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Nakonfigurujte automatickú populáciu hodnôt polí."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Zakázať automatické pridanie GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Ak nie je začiarknuté (predvolené), GBF Target 17 sa automaticky pridá na lokalitách biologickej bezpečnosti."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Zakázať automatické pridávanie krajín"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Ak nie je začiarknuté (predvolené), krajiny z bioland.settings sa automaticky pridajú do poľa."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfigurácia domény"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Všetky domény sú k dispozícii. Nakonfigurujte ich poradie zobrazenia nižšie."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Dostupné domény"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referenčný zoznam všetkých kľúčov domény a ich zobrazených názvov."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Objednávka domény"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Zadajte jedno ID domény na riadok a zadajte poradie zobrazenia. Všetky uvedené domény budú k dispozícii."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Neplatné ID domény: @domain"

