#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Setări automate ale valorii"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Configurați populația automată a valorilor câmpului."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Dezactivați adăugarea automată a țintei GBF 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Când este debifat (implicit), ținta GBF 17 va fi adăugată automat pe site-urile de biosecuritate."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Dezactivați adăugarea automată a țărilor"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Când este debifat (implicit), țările din bioland.settings vor fi adăugate automat în câmp."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Configurarea domeniului"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Toate domeniile sunt disponibile. Configurați ordinea de afișare mai jos."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Domenii disponibile"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Lista de referință a tuturor cheilor de domeniu și a numelor afișate ale acestora."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Comanda domeniului"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Introduceți un ID de domeniu pe linie pentru a specifica ordinea de afișare. Toate domeniile listate vor fi disponibile."

