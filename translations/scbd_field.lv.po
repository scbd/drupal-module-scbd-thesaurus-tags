#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Globālās bioloģiskās daudzveidības pamatmērķ"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nacionālie bioloģiskās daudzveidības mērķi (filtrēts pēc valsts)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Ilgtspējīgas attīstības mērķi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "valstis"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematiskās jomas/priekšmeti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Bioloģiskās drošības tematiskās jomas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Bioloģiskās drošības tematisko zonu grupas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Ģeogrāfiskie reģion"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ekosistēmu veidi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Atkļūdošanas režīms"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Parādiet slēptos ievades laukus atkļūdošanas nolūkos."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automātiskie vērtību iestatījumi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurējiet automātisko lauku vērtību populāciju."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Atspējojiet automātisko pievienošanas GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Ja tas nav atzīmēts (noklusējums), GBF Target 17 automātiski tiks pievienots bioloģiskās drošības vietās."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Atspējot valstu automātisko pievienošanas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Ja tas nav atzīmēts (noklusējums), laukam automātiski tiks pievienotas valstis no bioland.settings."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domēna konfigurācija"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Visi domēni ir pieejami. Konfigurējiet to displeja secību zemāk."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Pieejamie domēni"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Visu domēna atslēgu un to parādīto nosaukumu atsauces saraksts."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domēna pasūtījums"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Ievadiet vienu domēna ID katrā rindā, lai norādītu attēlošanas secību. Visi uzskaitītie domēni būs pieejami."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Nederīgs domēna ID: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "Atzīmes"

