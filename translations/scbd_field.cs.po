#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Globální cíle rámce pro biologickou rozmanitost"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Národní cíle biologické rozmanitosti (filtrováno podle země)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Cíle udržitelného rozvoje"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "země"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematické okruhy/Předměty"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Tematické oblasti biologické bezpečnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Skupiny tematických oblastí biologické bezpečnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografické regiony"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Typy ekosystémů"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Režim ladění"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Zobrazit skryté vstupní pole pro účely ladění."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatické nastavení hodnot"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Nakonfigurujte automatickou populaci hodnot polí."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Zakázat automatické přidání cíle GBF 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Pokud není zaškrtnuto (výchozí), GBF Target 17 bude automaticky přidán na místa biologické bezpečnosti."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Zakázat automatické přidávání zemí"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Pokud není zaškrtnuto (výchozí), země z bioland.settings budou automaticky přidány do pole."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfigurace domény"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Všechny domény jsou k dispozici. Nakonfigurujte jejich pořadí zobrazení níže."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Dostupné domény"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referenční seznam všech klíčů domény a jejich zobrazovaných názvů."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Objednávka domény"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Zadejte jedno ID domény na řádek a určete pořadí zobrazení. Všechny uvedené domény budou k dispozici."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Neplatné ID domény: @domain"

