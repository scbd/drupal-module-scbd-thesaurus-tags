#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Objetivos del Marco Mundial de Biodiversidad"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Metas nacionales de biodiversidad (filtradas por país)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Objetivos de desarrollo sostenible"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Países"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Áreas temáticas/asignaturas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Áreas temáticas de bioseguridad"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Grupos de áreas temáticas de bioseguridad"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Regiones geográficas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Tipos de ecosistemas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Modo de depuración"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Muestra los campos de entrada ocultos para fines de depuración."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Configuración automática de valores"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Configure el rellenado automático de los valores de los campos."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Desactivar la adición automática de GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Si no está marcada (opción predeterminada), la meta 17 del GBF se agregará automáticamente a los sitios de bioseguridad."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Desactivar la adición automática de países"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Si no está marcada (opción predeterminada), los países de bioland.settings se añadirán automáticamente al campo."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Configuración de dominio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Todos los dominios están disponibles. Configure su orden de visualización a continuación."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Dominios disponibles"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Lista de referencia de todas las claves de dominio y sus nombres para mostrar."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Orden de dominio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Introduzca un identificador de dominio por línea para especificar el orden de visualización. Todos los dominios de la lista estarán disponibles."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID de dominio no válido: @domain"

