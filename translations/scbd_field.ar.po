#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "أهداف الإطار العالمي للتنوع البيولوجي"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "الأهداف الوطنية للتنوع البيولوجي (تمت تصفيتها حسب البلد)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "أهداف التنمية المستدامة"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "بلدان"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "المجالات/الموضوعات المواضيعية"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "المجالات المواضيعية للسلامة البيولوجية"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "مجموعات المجالات المواضيعية للسلامة البيولوجية"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "المناطق الجغرافية"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "أنواع النظام البيئي"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "وضع التصحيح"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "اعرض حقول الإدخال المخفية لأغراض تصحيح الأخطاء."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "إعدادات القيمة التلقائية"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "قم بتكوين التعداد التلقائي لقيم الحقول."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "تعطيل الإضافة التلقائية لـ GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "عند إلغاء التحديد (الافتراضي)، ستتم إضافة GBF Target 17 تلقائيًا على مواقع السلامة الحيوية."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "تعطيل إضافة البلدان تلقائيًا"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "عند إلغاء التحديد (الافتراضي)، ستتم إضافة البلدان من bioland.settings تلقائيًا إلى الحقل."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "تكوين المجال"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "جميع المجالات متاحة. قم بتكوين ترتيب العرض الخاص بهم أدناه."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "النطاقات المتاحة"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "قائمة مرجعية لجميع مفاتيح المجال وأسماء العرض الخاصة بها."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "ترتيب الدومين"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "أدخل معرف مجال واحد لكل سطر لتحديد ترتيب العرض. جميع النطاقات المدرجة ستكون متاحة."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "معرف نطاق غير صالح: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "وسوم"

