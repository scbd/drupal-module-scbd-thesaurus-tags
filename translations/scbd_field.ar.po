msgstr "تم تحديث كاردينالية scbd_field_thesaurus إلى عدد غير محدود."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "قوائم موسعة مفصولة بفواصل إلى دلتا لـ scbd_field_thesaurus."
