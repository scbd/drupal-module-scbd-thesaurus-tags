#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "A biodiverzitás globális keretcéljai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nemzeti biodiverzitási célok (országonként szűrve)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Fenntartható fejlődési célok"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Országok"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematikus területek/témák"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Biológiai biztonsági tematikus területek"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Biológiai biztonsági tematikus területcsoportok"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Földrajzi régiók"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ökoszisztéma típusok"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Hibakeresési mód"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Mutassa meg a rejtett beviteli mezőket hibakeresési célokra."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatikus értékbeállítások"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurálja a mezőértékek automatikus populációját."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Tiltsa le a GBF Target 17 automatikus hozzáadását"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Ha nincs bejelölve (alapértelmezett), a GBF Target 17 automatikusan hozzáadódik a biológiai biztonsági helyeken."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Az országok automatikus hozzáadásának letiltása"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Ha nincs bejelölve (alapértelmezett), a bioland.settings országai automatikusan hozzáadódnak a mezőhöz."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Tartománykonfiguráció"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Minden domain elérhető. Állítsa be a megjelenítési sorrendjüket alább."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Elérhető domainek"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Az összes tartománykulcs és megjelenített neve hivatkozási listája."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domain Rendelés"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Adjon meg egy tartományazonosítót soronként a megjelenítési sorrend megadásához. Az összes felsorolt domain elérhető lesz."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Érvénytelen domain azonosító: @domain"

