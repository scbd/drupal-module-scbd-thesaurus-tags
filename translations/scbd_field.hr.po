msgstr "Grupe tematskih područja biološke sigurnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografske regije"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Vrste ekosustava"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Način otklanjanja pogrešaka"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Prikažite skrivena polja za unos u svrhu otklanjanja pogrešaka."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatske postavke vrijednosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurirajte automatsku populaciju vrijednosti polja."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Onemogućite automatsko dodavanje GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Kada nije označeno (zadano), GBF Target 17 automatski će se dodati na web mjesta biološke sigurnosti."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Onemogućite automatsko dodavanje zemalja"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Kada nije označeno (zadano), zemlje iz bioland.settings automatski će se dodati u polje."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfiguracija domene"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Sve domene su dostupne. Konfigurirajte njihov redoslijed prikaza u nastavku."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Dostupne domene"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referentni popis svih ključeva domene i njihovih imena za prikaz."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Narudžba domene"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Unesite jedan ID domene po retku da biste odredili redoslijed prikaza. Sve navedene domene bit će dostupne."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Nevažeći ID domene: @domain"

