msgstr "Nacionalni ciljevi biološke raznolikosti (filtrirano po državama)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Ciljevi održivog razvoja"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "zemlje"

