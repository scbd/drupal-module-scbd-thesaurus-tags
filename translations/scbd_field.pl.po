msgstr "Krajowe cele bioróżnorodności (filtrowane według kraju)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Cele zrównoważonego rozwoju"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Kraje"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Obszary tematyczne/przedmioty"

