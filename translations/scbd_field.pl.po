msgstr "Grupy obszarów tematycznych ds. bezpieczeństwa biologicznego"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Regiony geograficzne"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Typy ekosystemów"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Tryb debugowania"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Pokaż ukryte pola wejściowe do celów debugowania."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatyczne ustawienia wartości"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Skonfiguruj automatyczną populację wartości pól."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Wyłącz automatyczne dodawanie GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Jeśli nie jest zaznaczona (domyślnie), GBF Target 17 zostanie automatycznie dodany do witryn bezpieczeństwa biologicznego."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Wyłącz automatyczne dodawanie krajów"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Po wyłączeniu zaznaczenia (domyślnie) kraje z bioland.settings zostaną automatycznie dodane do pola."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfiguracja domeny"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Wszystkie domeny są dostępne. Skonfiguruj kolejność wyświetlania poniżej."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Dostępne domeny"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Lista referencyjna wszystkich kluczy domen i ich wyświetlane nazwy."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Zamówienie domeny"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Wprowadź jeden identyfikator domeny na wiersz, aby określić kolejność wyświetlania. Wszystkie wymienione domeny będą dostępne."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Nieprawidłowy identyfikator domeny: @domain"

