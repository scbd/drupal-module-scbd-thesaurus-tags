#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Pasaulinės biologinės įvairovės pagrindų tikslai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nacionaliniai biologinės įvairovės tikslai (filtruota pagal šalis)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Darnaus vystymosi tikslai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Šalys"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Teminės sritys/dalykai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Biologinės saugos teminės sritys"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Biologinės saugos teminių sričių grupės"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografiniai regionai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ekosistemų tipai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Derinimo režimas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Rodyti paslėptus įvesties laukus derinimo tikslais."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatiniai vertės nustatymai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigūruokite automatinę lauko reikšmių populiaciją."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Išjunkite automatinį GBF Target 17 pridėjimą"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Kai nepažymėta (numatytasis nustatymas), GBF Target 17 automatiškai bus pridėtas biosaugos svetainėse."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Išjungti automatinį šalių pridėjimą"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Kai nepažymėta (numatytoji), šalys iš bioland.settings automatiškai bus įtrauktos į lauką."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domeno konfigūracija"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Visi domenai yra prieinami. Žemiau sukonfigūruokite jų rodymo tvarką."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Galimi domenai"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Visų domenų raktų ir jų rodomų vardų nuorodų sąrašas."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domeno užsakymas"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Įveskite vieną domeno ID kiekvienoje eilutėje, kad nurodytumėte rodymo tvarką. Visi išvardyti domenai bus prieinami."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Netinkamas domeno ID: @domain"

