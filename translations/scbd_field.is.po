msgstr "Þemasvæði líföryggis"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Þemahópar um lífsöryggi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Landfræðileg svæði"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Tegundir vistkerfa"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Kembiforstilling"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Sýna falda innsláttarreitina til kembiforritunar."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Sjálfvirkar gildisstillingar"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Stilltu sjálfvirka íbúð sviðsgilda."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Slökkva á sjálfvirkri bætt við GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Þegar það er óskoðað (sjálfgefið) verður GBF Target 17 sjálfkrafa bætt við á lífsöryggisstöðum."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Slökkva á sjálfvirkri bæta við löndum"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Þegar það er ómerkt (sjálfgefið) verður lönd frá bioland.settings sjálfkrafa bætt við reitinn."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Stillingar léns"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Öll lén eru í boði. Stilltu birtingarröð þeirra hér að neðan."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Tiltæk lén"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Tilvísunarlisti yfir alla lénalykla og birtingarnöfn þeirra."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Pöntun léns"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Sláðu inn eitt lénsauðkenni í hverri línu til að tilgreina birtingarröð. Öll skráð lén verða tiltæk."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Ógilt lénsauðkenni: @domain"

