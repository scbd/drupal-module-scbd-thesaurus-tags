#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Режим налагодження"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Показувати приховані поля введення для налагодження."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Автоматичні налаштування значень"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Налаштування автоматичної сукупності значень полів."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Вимкнути автоматичне додавання GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Якщо не позначено (за замовчуванням), GBF Target 17 буде автоматично додано на сайти біобезпеки."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Вимкнути автоматичне додавання країн"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Якщо позначку знято (за замовчуванням), країни з bioland.settings будуть автоматично додані до поля."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Конфігурація домену"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Доступні всі домени. Налаштуйте їх порядок відображення нижче."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Доступні домени"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Список посилань на всі доменні ключі та їх відображені імена."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Замовлення домену"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Введіть один ідентифікатор домену на рядок, щоб вказати порядок відображення. Всі перераховані домени будуть доступні."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Недійсний ідентифікатор домену: @domain"

