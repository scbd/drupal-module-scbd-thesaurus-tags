msgstr "Kaikki verkkotunnukset ovat käytettävissä. Määritä niiden näyttöjärjestys alla."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Käytettävissä olevat verkkotunnukset"

#: src/Form/ScbdFieldSettingsForm.php
