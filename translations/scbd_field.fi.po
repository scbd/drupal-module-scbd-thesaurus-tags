msgid "Automatic Value Settings"
msgstr "Automaattiset arvoasetukset"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Määritä kenttäarvojen automaattinen populaatio."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Poista GBF Target 17: n automaattinen lisääminen käytöstä"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Kun sitä ei ole valittu (oletus), GBF Target 17 lisätään automaattisesti bioturvallisuuskohteisiin."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Poista maiden automaattinen lisääminen käytöstä"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Jos valinta ei ole valittu (oletus), bioland.settings -sivuston maat lisätään automaattisesti kenttään."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Verkkotunnuksen määritykset"

