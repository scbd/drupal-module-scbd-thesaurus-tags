msgstr "Vis de skjulte inndatafeltene for feilsøkingsformål."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatiske verdiinnstillinger"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurer automatisk populasjon av feltverdier."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Deaktiver automatisk legg til GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Når det ikke er merket (standard), vil GBF Target 17 automatisk legges til på biosikkerhetssteder."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Deaktiver automatisk legg til land"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Når det ikke er merket av (standard), legges land fra bioland.settings automatisk til i feltet."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domenekonfigurasjon"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Alle domener er tilgjengelige. Konfigurer visningsrekkefølgen nedenfor."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Tilgjengelige domener"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referanseliste over alle domenenøkler og deres visningsnavn."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domenerekkefølge"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Angi én domene-ID per linje for å spesifisere visningsrekkefølgen. Alle oppførte domener vil være tilgjengelige."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Ugyldig domene-ID: @domain"

