#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Ғаламдық биоалуантүрлілік"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Биоәртүрліліктің ұлттық мақсаттары (ел бойынша сүзілген)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Тұрақты даму мақсаттары"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Елдер"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Тақырыптық бағыттар/пәндер"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Биологиялық қауіпсіздік тақырыптық бағыттары"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Биологиялық қауіпсіздік тақырыптық аймағы топтары"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Географиялық аймақтар"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Экожүйе түрлері"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Отладка режимі"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Отладка мақсатында жасырын енгізу өрістерін көрсетіңіз."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Автоматты мән параметрлері"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Өріс мәндерінің автоматты популяциясын теңшеңіз."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "GBF Target 17 автоматты түрде қосуды өшіріңіз"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Тексерілмеген кезде (әдепкі), GBF Target 17 автоматты түрде биоқауіпсіздік сайттарында қосылады."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Елдерді автоматты түрде қосуды өшіру"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Қабылданбаған кезде (әдепкі), bioland.settings ішінен елдер автоматты түрде өріске қосылады."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Домен конфигурациясы"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Барлық домендер қол жетімді. Төменде олардың көрсету тәртібін теңшеңіз."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Қол жетімді домендер"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Барлық домен кілттерінің және олардың көрсету атауларының анықтамалық тізімі."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Домендік тапсырыс"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Көрсету тәртібін көрсету үшін бір жолға бір домен идентификаторын енгізіңіз. Барлық тізімделген домендер қол жетімді болады."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Жарамсыз домен идентификаторы: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "Тегтер"

#: scbd_field.install:21
msgid "Updated scbd_field_thesaurus cardinality to unlimited."
msgstr "scbd_field_thesaurus кардиналдылығын шексіз етіп жаңартты."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "scbd_field_thesaurus үшін делталарға үтірмен бөлінген тізімдерді кеңейтті."
