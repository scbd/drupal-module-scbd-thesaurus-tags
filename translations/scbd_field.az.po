#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Ayıklama məqsədləri üçün gizli giriş sahələrini göstərin."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Avtomatik Dəyər Ayarları"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Sahə dəyərlərinin avtomatik populyasiyasını konfiqurasiya edin."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "GBF Target 17-ni avtomatik əlavə etməyi deaktiv edin"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Yoxlanmadıqda (standart), GBF Target 17 avtomatik olaraq biotəhlükəsizlik saytlarına əlavə olunacaq."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Ölkələri avtomatik əlavə etməyi deaktiv edin"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "İşlənilmədikdə (standart), bioland.settings saytından olan ölkələr avtomatik olaraq sahəyə əlavə olunacaq."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domen konfiqurasiyası"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Bütün domenlər mövcuddur. Aşağıda onların ekran qaydasını konfiqurasiya edin."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Mövcud domenlər"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Bütün domen düymələrinin istinad siyahısı və onların göstərilən adları."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domen Sifarişi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Ekran qaydasını təyin etmək üçün hər sətir üçün bir domen identifikatoru daxil edin. Bütün siyahıya alınan domenlər mövcud olacaq."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Yanlış domen identifikatoru: @domain"

