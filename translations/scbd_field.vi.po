msgstr "Đã cập nhật tính năng scbd_field_thesaurus thành không giới hạn."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "Các danh sách được phân tách bằng dấu phẩy mở rộng thành delta cho scbd_field_thesaurus."

