#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Mục tiêu Khung Đa dạng Sinh học Toàn cầu"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Mục tiêu đa dạng sinh học quốc gia (lọc theo quốc gia)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Mục tiêu phát triển bền vững"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Quốc gia"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Lĩnh vực chuyên đề/Môn học"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Các lĩnh vực chuyên đề an toàn sinh học"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Nhóm khu vực chuyên đề an toàn sinh học"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Khu vực địa lý"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Các loại hệ sinh thái"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Chế độ gỡ lỗi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Hiển thị các trường nhập ẩn cho mục đích gỡ lỗi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Cài đặt giá trị tự động"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Định cấu hình dân số tự động của các giá trị trường."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Vô hiệu hóa tự động thêm GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Khi không được chọn (mặc định), GBF Target 17 sẽ tự động được thêm vào các trang web an toàn sinh học."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Vô hiệu hóa quốc gia tự động thêm"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Khi không được chọn (mặc định), các quốc gia từ bioland.settings sẽ tự động được thêm vào trường."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Cấu hình miền"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Tất cả các tên miền đều có sẵn. Định cấu hình thứ tự hiển thị của họ bên dưới."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Tên miền có sẵn"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Danh sách tham chiếu của tất cả các khóa miền và tên hiển thị của chúng."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Đặt hàng tên miền"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Nhập một ID miền trên mỗi dòng để chỉ định thứ tự hiển thị. Tất cả các tên miền được liệt kê sẽ có sẵn."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID miền không hợp lệ: @domain"

