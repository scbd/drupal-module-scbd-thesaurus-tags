#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Paramètres de valeurs automatiques"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Configurer le remplissage automatique des valeurs de champ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Désactiver l'ajout automatique de la cible 17 du CMB"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Si non coché (par défaut), la cible 17 du CMB sera automatiquement ajoutée sur les sites de biosécurité."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Désactiver l'ajout automatique des pays"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Si non coché (par défaut), les pays de bioland.settings seront automatiquement ajoutés au champ."

#: src/Form/ScbdFieldSettingsForm.php
