#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automaatsed väärtuse seaded"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigureerige väljaväärtuste automaatne populatsioon."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Keela GBF Target 17 automaatne lisamine"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Kui see pole märgitud (vaikimisi), lisatakse GBF Target 17 automaatselt bioohutuse saitidele."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Keela riikide automaatne lisamine"

