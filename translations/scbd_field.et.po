msgid "Available Domains"
msgstr "Saadaval domeenid"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Kõigi domeeniklahvide ja nende kuvatavate nimede viiteloend."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domeeni tellimus"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Kuvamisjärjekorra määramiseks sisestage üks domeeni ID rea kohta. Kõik loetletud domeenid on saadaval."

