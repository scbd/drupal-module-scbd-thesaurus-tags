#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Settings Awtomatiċi tal-Valur"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Kkonfigurat popolazzjoni awtomatika tal-valuri tal-kamp."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Iddiżattiva l-iżid awtomatiku GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Meta mhux iċċekkjat (default), GBF Target 17 awtomatikament se jiżdied fuq siti bijosikurezza."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Iddiżattiva pajjiżi li jiżdiedu awtomatiku"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Meta mhux iċċekkjat (default), il-pajjiżi minn bioland.settings awtomatikament jiġu miżjuda mal-qasam."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfigurazzjoni tad-Dominju"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Id-dominji kollha huma disponibbli. Ikkonfigura l-ordni tal-wiri tagħhom hawn taħt."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Dominji Disponibbli"

