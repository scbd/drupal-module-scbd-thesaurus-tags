msgstr "Lista ta' referenza taċ-ċwievet kollha tad-dominju u l-ismijiet tal-wiri tagħhom."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Ordni ta' Dominju"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Daħħal ID tad-dominju wieħed għal kull linja biex tispeċifika l-ordni tal-wiri. Id-dominji elenkati kollha se jkunu disponibbli."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
