msgstr "Coğrafi Bölgeler"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ekosistem Türleri"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Hata ayıklama modu"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Hata ayıklama amacıyla gizli giriş alanlarını göster."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Otomatik Değer Ayarları"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Alan değerlerinin otomatik popülasyonunu yapılandırın."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "GBF Hedef 17'yi otomatik ekleme devre dışı bırak"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "İşaretlenmediğinde (varsayılan), GBF Hedef 17 biyogüvenlik alanlarına otomatik olarak eklenecektir."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Ülkeleri otomatik ekleme devre dışı bırak"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "İşareti kaldırılmadığında (varsayılan), bioland.settings adresindeki ülkeler otomatik olarak alana eklenecektir."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Etki Alanı Yapılandırma"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Tüm alan adları kullanılabilir. Görüntüleme sıralarını aşağıda yapılandırın."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Kullanılabilir Etki Alanları"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Tüm etki alanı anahtarlarının ve görüntülenen adlarının referans listesi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Alan Adı Siparişi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Görüntüleme sırasını belirtmek için satır başına bir etki alanı kimliği girin. Listelenen tüm alan adları kullanılabilir olacaktır."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Geçersiz etki alanı kimliği: @domain"

