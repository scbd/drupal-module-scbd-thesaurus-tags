#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Globale rammemål for biodiversitet"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nationale biodiversitetsmål (filtreret efter land)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Bæredygtige udviklingsmål"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "lande"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematiske områder/emner"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Biosikkerhedstematiske områder"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Biosikkerhedstematiske områdegrupper"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografiske regioner"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Økosystemtyper"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Fejlfindingstilstand"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Vis de skjulte inputfelter til fejlfindingsformål."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatiske værdiindstillinger"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurer automatisk population af feltværdier."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Deaktiver automatisk tilføj GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Når det ikke er markeret (standard), tilføjes GBF Target 17 automatisk på biosikkerhedssteder."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Deaktiver automatisk tilføjelse af lande"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Når det ikke er markeret (standard), føjes lande fra bioland.settings automatisk til feltet."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domænekonfiguration"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Alle domæner er tilgængelige. Konfigurer deres visningsrækkefølge nedenfor."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Tilgængelige domæner"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referenceliste over alle domænenøgler og deres viste navne."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domæneordre"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Angiv ét domæne-id pr. linje for at angive visningsrækkefølgen. Alle listede domæner vil være tilgængelige."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Ugyldigt domæne-id: @domain"

