msgstr "Дибаг хийх зорилгоор далд оролтын талбаруудыг харуул."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Автомат утгын тохиргоо"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Талбарын утгын автомат популяцийг тохируулах."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "GBF Зорилтот 17-ыг автоматаар нэмэхийг идэвхгүй болгох"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Шалгаагүй үед (анхдагч), GBF Зорилтот 17 автоматаар биоаюулгүй байдлын сайтууд дээр нэмэгдэх болно."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Автоматаар нэмэх орнуудыг идэвхгүй болгох"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Шалгаагүй (анхдагч) үед bioland.settings-ээс улсууд автоматаар талбарт нэмэгдэх болно."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Домэйн тохиргоо"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Бүх домэйнууд боломжтой. Тэдний дэлгэцийн дарааллыг доор тохируулна уу."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Боломжит домайнууд"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Бүх домэйн түлхүүрүүд болон тэдгээрийн дэлгэцийн нэрсийн лавлагааны жагсаалт."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Домэйн захиалга"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Дэлгэцийн дарааллыг заахын тулд мөрөнд нэг домэйн ID оруулна уу. Бүх жагсаасан домэйнууд бэлэн болно."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Хүчин төгөлдөр бус домэйн ID: @domain"

