#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Цели на глобалната рамка за биоразнообразие"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Национални цели за биологичното разнообразие (филтрирани по държави)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Цели за устойчиво развитие"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Държави"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Тематични области/Предмети"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Тематични области за биологична безопасност"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Групи за тематични области за биологична безопасност"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Географски региони"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Типове екосистеми"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Режим на отстраняване на грешки"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Покажете скритите полета за въвеждане за целите на отстраняване на грешки."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Автоматични настройки на стойността"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Конфигурирайте автоматичната популация на стойностите на полетата."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Деактивирайте автоматичното добавяне на GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Когато не е отметнато (по подразбиране), GBF Target 17 автоматично ще бъде добавен в сайтовете за биологична безопасност."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Деактивирайте автоматичното добавяне на държави"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Когато няма отметка (по подразбиране), държавите от bioland.settings автоматично ще бъдат добавени към полето."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Настройка на домейна"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Всички домейни са налични. Конфигурирайте реда им на показване по-долу."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Налични домейни"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Референтен списък на всички ключове на домейни и техните показвани имена."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Поръчка на домейн"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Въведете един идентификатор на домейн на ред, за да посочите реда на показване. Всички изброени домейни ще бъдат налични."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Невалиден идентификатор на домейн: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "Тагове"

#: scbd_field.install:21
msgid "Updated scbd_field_thesaurus cardinality to unlimited."
msgstr "Актуализирана кардиналността на scbd_field_thezaurus до неограничена."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "Разширени списъци, разделени със запетаи в делти за scbd_field_tezaurus."
