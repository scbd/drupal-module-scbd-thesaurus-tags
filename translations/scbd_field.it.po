msgstr "Paesi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Aree tematiche/argomenti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Aree tematiche sulla biosicurezza"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Gruppi di aree tematiche sulla biosicurezza"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Regioni geografiche"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Tipi di ecosistemi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "modalità di debug"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Mostra i campi di input nascosti per scopi di debug."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Impostazioni automatiche dei valori"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Configura il popolamento automatico dei valori dei campi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Disattiva l'aggiunta automatica di GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Se deselezionato (impostazione predefinita), GBF Target 17 verrà aggiunto automaticamente nei siti di biosicurezza."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Disattiva l'aggiunta automatica dei paesi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Se deselezionata (impostazione predefinita), i paesi di bioland.settings verranno aggiunti automaticamente al campo."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Configurazione del dominio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Tutti i domini sono disponibili. Configura il loro ordine di visualizzazione qui sotto."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Domini disponibili"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Elenco di riferimento di tutte le chiavi di dominio e dei relativi nomi visualizzati."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Ordine del dominio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Inserisci un ID di dominio per riga per specificare l'ordine di visualizzazione. Tutti i domini elencati saranno disponibili."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID di dominio non valido: @domain"

