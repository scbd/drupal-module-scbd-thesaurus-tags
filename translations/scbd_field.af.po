#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Outomatiese waarde-instellings"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Stel outomatiese populasie van veldwaardes op."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Deaktiveer outomatiese byvoeging van GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "As dit nie gekontroleer is (standaard), sal GBF Target 17 outomaties op bioveiligheidswerwe bygevoeg word."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Deaktiveer outomatiese byvoeging lande"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "As dit nie gekies is nie (standaard), sal lande van bioland.settings outomaties by die veld gevoeg word."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domeinkonfigurasie"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Alle domeine is beskikbaar. Stel hul vertoonvolgorde hieronder in."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Beskikbare domeine"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Verwysingslys van alle domeinsleutels en hul vertoonname."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domeinbestelling"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Voer een domein-ID per reël in om vertoonvolgorde te spesifiseer. Alle gelyste domeine sal beskikbaar wees."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
