msgid "Debug mode"
msgstr "ಡೀಬಗ್ ಮೋಡ್"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "ಡೀಬಗ್ ಮಾಡುವ ಉದ್ದೇಶಗಳಿಗಾಗಿ ಗುಪ್ತ ಇನ್ಪುಟ್ ಕ್ಷೇತ್ರಗಳನ್ನು ತೋರಿಸಿ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "ಸ್ವಯಂಚಾಲಿತ ಮೌಲ್ಯ ಸೆ"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "ಕ್ಷೇತ್ರ ಮೌಲ್ಯಗಳ ಸ್ವಯಂಚಾಲಿತ ಜನಸಂಖ್ಯೆಯನ್ನು ಸಂರಚಿಸಿ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "ಜಿಬಿಎಫ್ ಟಾರ್ಗೆಟ್ 17 ಸ್ವಯಂ-ಸೇರಿಸಿ ನಿಷ್ಕ್ರಿಯ"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "ಪರಿಶೀಲಿಸದಿದ್ದಾಗ (ಡೀಫಾಲ್ಟ್), ಜಿಬಿಎಫ್ ಟಾರ್ಗೆಟ್ 17 ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಜೈವಿಕ ಸುರಕ್ಷತಾ ಸೈಟ್ಗಳಲ್ಲಿ ಸೇರಿಸಲ್ಪಡುತ್ತದೆ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "ಸ್ವಯಂ-ಸೇಡ್ ದೇಶಗಳನ್ನು ನಿಷ್ಕ್ರಿಯಗೊ"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "ಪರಿಶೀಲಿಸದಿದ್ದಾಗ (ಡೀಫಾಲ್ಟ್), bioland.settings ನಿಂದ ದೇಶಗಳು ಸ್ವಯಂಚಾಲಿತವಾಗಿ ಕ್ಷೇತ್ರಕ್ಕೆ ಸೇರಿಸಲ್ಪಡುತ್ತವೆ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "ಡೊಮೇನ್ ಸಂರಚನೆ"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "ಎಲ್ಲಾ ಡೊಮೇನ್ಗಳು ಲಭ್ಯವಿದೆ. ಕೆಳಗೆ ಅವರ ಪ್ರದರ್ಶನ ಕ್ರಮವನ್ನು ಕಾನ್ಫಿಗರ್ ಮಾಡಿ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "ಲಭ್ಯವಿರುವ ಡೊಮೇನ್"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "ಎಲ್ಲಾ ಡೊಮೇನ್ ಕೀಲಿಗಳು ಮತ್ತು ಅವುಗಳ ಪ್ರದರ್ಶನ ಹೆಸರುಗಳ ಉಲ್ಲೇಖ ಪಟ್ಟಿ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "ಡೊಮೇನ್ ಆದೇಶ"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "ಪ್ರದರ್ಶನ ಕ್ರಮವನ್ನು ನಿರ್ದಿಷ್ಟಪಡಿಸಲು ಪ್ರತಿ ಸಾಲಿಗೆ ಒಂದು ಡೊಮೇನ್ ಐಡಿಯನ್ನು ನಮೂದಿಸಿ. ಪಟ್ಟಿ ಮಾಡಲಾದ ಎಲ್ಲಾ ಡೊಮೇನ್ಗಳು ಲಭ್ಯವಿರುತ್ತವೆ."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ಅಮಾನ್ಯ ಡೊಮೇನ್ ಐಡಿ: @domain"

