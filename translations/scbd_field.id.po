msgstr "Kelompok Area Tematik Keamanan Hayati"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Wilayah Geografis"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Jenis Ekosistem"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Modus debug"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Tampilkan bidang input tersembunyi untuk tujuan debugging."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Pengaturan Nilai Otomatis"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurasikan populasi otomatis nilai bidang."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Nonaktifkan penambahan otomatis Target GBF 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Jika tidak dicentang (default), Target GBF 17 akan secara otomatis ditambahkan di situs keamanan hayati."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Nonaktifkan negara penambahan otomatis"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Jika tidak dicentang (default), negara dari bioland.settings akan secara otomatis ditambahkan ke bidang."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfigurasi Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Semua domain tersedia. Konfigurasikan urutan tampilan mereka di bawah ini."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Domain yang Tersedia"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Daftar referensi semua kunci domain dan nama tampilannya."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Pesanan Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Masukkan satu ID domain per baris untuk menentukan urutan tampilan. Semua domain yang terdaftar akan tersedia."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID domain tidak valid: @domain"

