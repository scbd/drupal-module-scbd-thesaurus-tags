#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Στόχοι Παγκόσμιου Πλαισίου Βιοποικιλότητας"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Εθνικοί στόχοι βιοποικιλότητας (φιλτράρισμα ανά χώρα)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Στόχοι Βιώσιμης Ανάπτυξης"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "χωρών"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Θεματικοί Τομές/Θέματα"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Θεματικοί τομείς βιοασφάλειας"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Ομάδες Θεματικών Περιοχών Βιοασφάλειας"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Γεωγραφικές περιοχές"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Τύποι οικοσυστημάτων"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Λειτουργία εντοπισμού σφαλμάτων"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Εμφάνιση των κρυφών πεδίων εισαγωγής για σκοπούς εντοπισμού σφαλμάτων."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Αυτόματες ρυθμίσεις τιμών"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Διαμορφώστε τον αυτόματο πληθυσμό τιμών πεδίου."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Απενεργοποιήστε την αυτόματη προσθήκη στόχου GBF 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Όταν δεν έχει επιλεγεί (προεπιλογή), το GBF Target 17 θα προστεθεί αυτόματα σε ιστότοπους βιοασφάλειας."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Απενεργοποίηση αυτόματης προσθήκης χωρών"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Όταν δεν επιλεγεί (προεπιλογή), οι χώρες από το bioland.settings θα προστεθούν αυτόματα στο πεδίο."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Διαμόρφωση τομέα"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Όλα τα domain είναι διαθέσιμα. Διαμορφώστε τη σειρά εμφάνισης παρακάτω."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Διαθέσιμοι τομείς"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Λίστα αναφοράς όλων των κλειδιών τομέα και των εμφανιζόμενων ονομάτων τους."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Παραγγελία τομέα"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Εισαγάγετε ένα αναγνωριστικό τομέα ανά γραμμή για να καθορίσετε τη σειρά εμφάνισης. Όλοι οι καταχωρημένοι τομείς θα είναι διαθέσιμοι."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Μη έγκυρο αναγνωριστικό τομέα: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "Ετικέτες"

#: scbd_field.install:21
msgid "Updated scbd_field_thesaurus cardinality to unlimited."
msgstr "Ενημερώθηκε η καρδιναλικότητα του scbd_field_thesaurus σε απεριόριστη."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "Διευρυμένες λίστες διαχωρισμένες με κόμματα σε δέλτα για το scbd_field_thesaurus."
