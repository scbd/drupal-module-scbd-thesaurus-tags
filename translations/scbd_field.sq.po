#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Objektivat e kornizës globale të bio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Objektivat Kombëtare të Biodiversitetit (filtruar sipas vendit)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Qëllimet e Zhvillimit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "shtetet"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Fushat tematike/Subjektet"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Fushat Tematike të Biosigurisë"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Grupet Tematike të Zonave të Biosigurisë"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Rajonet gjeografike"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Llojet e ekosistemit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Modaliteti i korrigjimit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Trego fushat e fshehura të hyrjes për qëllime korrigjimi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Cilësimet automatike të vlerës"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfiguro popullsinë automatike të vlerave të fushës."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Çaktivizoni shtimin automatik të GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Kur nuk kontrollohet (parazgjedhur), GBF Target 17 do të shtohet automatikisht në faqet e biosigurisë."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Çaktivizo shtimin automatik të vendeve"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Kur nuk kontrollohet (parazgjedhje), vendet nga bioland.settings automatikisht do të shtohen në fushë."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfigurimi i domenit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Të gjitha domenet janë në dispozicion. Konfiguroni rendin e tyre të shfaqjes më poshtë."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Domenet e disponueshme"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Lista referimi e të gjithë çelësave të domenit dhe emrat e tyre të shfaqjes."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Urdhri i domenit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Futni një ID domaini për rresht për të specifikuar rendin e shfaqjes. Të gjitha domenet e listuara do të jenë në dispozicion."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID i pavlefshëm i domainit: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "Etiketat"

#: scbd_field.install:21
msgid "Updated scbd_field_thesaurus cardinality to unlimited."
msgstr "Përditësuar kardinaliteti scbd_field_thesaurus në të pakufizuar."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "Listat e zgjeruara të ndara me presë në delta për scbd_field_thesaurus."
