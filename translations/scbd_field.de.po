#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Ziele des globalen Biodiversitätsrahmenplans"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nationale Biodiversitätsziele (nach Ländern gefiltert)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Ziele für nachhaltige Entwicklung"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Länder"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Themenfelder/Fächer"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Themenbereiche Biosicherheit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Thematische Bereichsgruppen zur biologischen Sicherheit"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografische Regionen"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Arten von Ökosystemen"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Debug-Modus"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Zeigt die versteckten Eingabefelder für Debugging-Zwecke an."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatische Werteinstellungen"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurieren Sie das automatische Auffüllen von Feldwerten."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Deaktivieren Sie das automatische Hinzufügen von GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Wenn diese Option deaktiviert ist (Standardeinstellung), wird GBF Target 17 automatisch auf Websites mit biologischer Sicherheit hinzugefügt."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Deaktiviere das automatische Hinzufügen von Ländern"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Wenn diese Option deaktiviert ist (Standardeinstellung), werden Länder aus bioland.settings automatisch zum Feld hinzugefügt."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domain-Konfiguration"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Alle Domains sind verfügbar. Konfigurieren Sie unten ihre Anzeigereihenfolge."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Verfügbare Domains"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referenzliste aller Domainschlüssel und ihrer Anzeigenamen."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domain-Bestellung"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Geben Sie eine Domain-ID pro Zeile ein, um die Anzeigereihenfolge festzulegen. Alle aufgelisteten Domains werden verfügbar sein."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Ungültige Domain-ID: @domain"

