#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Configurações automáticas de valor"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Configure o preenchimento automático dos valores do campo."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Desative a adição automática do GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Quando desmarcado (padrão), o GBF Target 17 será adicionado automaticamente em sites de biossegurança."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Desativar a adição automática de países"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Quando desmarcada (padrão), os países de bioland.settings serão automaticamente adicionados ao campo."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Configuração de domínio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Todos os domínios estão disponíveis. Configure a ordem de exibição abaixo."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Domínios disponíveis"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Lista de referência de todas as chaves de domínio e seus nomes de exibição."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Pedido de domínio"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Insira um ID de domínio por linha para especificar a ordem de exibição. Todos os domínios listados estarão disponíveis."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID de domínio inválida: @domain"

