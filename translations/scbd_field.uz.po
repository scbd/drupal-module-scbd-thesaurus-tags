#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Global biologik xilma-xillik doirasida maqsadlar"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Milliy bioxilma-xillik maqsadlari (mamlakat bo'yicha filtrlangan)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Barqaror rivojlanish maqsadlari"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Mamlakatlar"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematik sohalar/mavzular"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Biologik xavfsizlik mavzuli sohalari"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Biologik xavfsizlik mavzuli guruhlari"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografik mintaqalar"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ekotizim turlari"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Disk raskadrovka rejimi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Disk raskadrovka maqsadlari uchun yashirin kirish maydonlarini ko'rsatish."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Avtomatik qiymat sozlamalari"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Maydon qiymatlarining avtomatik populyatsiyasini sozlang."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "GBF Target 17-ni avtomatik qo'shishni o'chirib qo'ying"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Tekshirilmaganda (asl qiymati), GBF Target 17 avtomatik ravishda bioxavfsizlik saytlarida qo'shiladi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Mamlakatlarni avtomatik qo'shishni o'chirib qo'ying"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Belgilanmagan (default) bo'lganda bioland.settings dan mamlakatlar avtomatik ravishda maydonga qo'shiladi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domen konfiguratsiyasi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Barcha domenlar mavjud. Quyida ularning ko'rsatish tartibini sozlang."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Mavjud domenlar"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Barcha domen kalitlari va ularning ko'rsatish nomlarining mos yozuvlar ro'yxati."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domen tartibi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Displey tartibini belgilash uchun har bir satr uchun bitta domen identifikatorini kiriting. Ro'yxatdagi barcha domenlar mavjud bo'ladi."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Yaroqsiz domen identifikatori: @domain"

#: src/Plugin/Field/FieldWidget/ScbdThesaurusWidget.php:40
msgid "Tags"
msgstr "Teglar"

#: scbd_field.install:21
msgid "Updated scbd_field_thesaurus cardinality to unlimited."
msgstr "Scbd_field_thesaurus cardinality cheksizlikka yangilandi."

#: scbd_field.install:29
msgid "Expanded comma-separated lists into deltas for scbd_field_thesaurus."
msgstr "scbd_field_thesaurus uchun deltalarga vergul bilan ajratilgan ro'yxatlarni kengaytirdi."
