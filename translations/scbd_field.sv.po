#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Globala rammål för biologisk mångfald"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nationella mål för biologisk mångfald (filtrerat efter land)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Målen för hållbar utveckling"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Länder"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Temaområden/Ämnen"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Tematiska områden för biosäkerhet"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Tematiska områdesgrupper för biosäkerhet"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografiska regioner"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Ekosystemtyper"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Felsökningsläge"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Visa de dolda inmatningsfälten för felsökningsändamål."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Automatiska värdeinställningar"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurera automatisk population av fältvärden."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Inaktivera automatiskt lägga till GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "När det inte är markerat (standard) läggs GBF Target 17 automatiskt till på biosäkerhetsplatser."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Inaktivera automatiskt lägga till länder"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Om det inte är markerat (standard) läggs länder från bioland.settings automatiskt till i fältet."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Domänkonfiguration"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Alla domäner är tillgängliga. Konfigurera deras visningsordning nedan."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Tillgängliga domäner"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referenslista över alla domännycklar och deras visningsnamn."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Domänbeställning"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Ange ett domän-ID per rad för att ange visningsordning. Alla listade domäner kommer att vara tillgängliga."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Ogiltigt domän-ID: @domain"

