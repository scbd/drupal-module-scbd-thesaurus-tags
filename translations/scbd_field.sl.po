#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Cilji globalnega okvira biotske raznovr"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Nacionalni cilji biotske raznovrstnosti (filtrirano po državah)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Cilji trajnostnega razvoja"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "Države"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Tematska področja/predmeti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Tematska področja biološke varnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Tematske skupine področij biološke varnosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Geografske regije"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Vrste ekosistemov"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Način odpravljanja napak"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Pokažite skrita vhodna polja za namene odpravljanja napak."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Samodejne nastavitve vrednosti"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurirajte samodejno populacijo vrednosti polj."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Onemogoči samodejno dodajanje GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Ko ni označeno (privzeto), bo GBF Target 17 samodejno dodan na mestih biološke varnosti."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Onemogoči samodejno dodajanje držav"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Ko ni označeno (privzeto), bodo države iz bioland.settings samodejno dodane v polje."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfiguracija domene"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Vse domene so na voljo. Spodaj konfigurirajte njihov vrstni red prikaza."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Razpoložljive domene"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Referenčni seznam vseh domenskih ključev in njihovih prikaznih imen."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Naročilo domene"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Vnesite en ID domene na vrstico, da določite vrstni red prikaza. Na voljo bodo vse navedene domene."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "Neveljaven ID domene: @domain"

