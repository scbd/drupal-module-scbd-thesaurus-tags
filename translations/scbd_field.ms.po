#: src/Form/ScbdFieldSettingsForm.php
msgid "Global Biodiversity Framework Targets"
msgstr "Sasaran Rangka Kerja Biodiversiti Global"

#: src/Form/ScbdFieldSettingsForm.php
msgid "National Biodiversity Targets (filtered by country)"
msgstr "Sasaran Biodiversiti Nasional (ditapis mengikut negara)"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Sustainable Development Goals"
msgstr "Matlamat Pembangunan Mampan"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Countries"
msgstr "negara"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Thematic Areas/Subjects"
msgstr "Bidang/Subjek Tematik"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Areas"
msgstr "Kawasan Tematik Biokeselamatan"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Biosafety Thematic Area Groups"
msgstr "Kumpulan Kawasan Tematik Biokeselamatan"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Geographic Regions"
msgstr "Kawasan Geografi"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Ecosystem Types"
msgstr "Jenis Ekosistem"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Debug mode"
msgstr "Mod debug"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Show the hidden input fields for debugging purposes."
msgstr "Tunjukkan medan input tersembunyi untuk tujuan debugging."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Automatic Value Settings"
msgstr "Tetapan Nilai Automatik"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Configure automatic population of field values."
msgstr "Konfigurasikan populasi automatik nilai medan."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add GBF Target 17"
msgstr "Lumpuhkan tambah automatik GBF Target 17"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), GBF Target 17 will automatically be added on biosafety sites."
msgstr "Apabila tidak diperiksa (lalai), GBF Target 17 akan ditambah secara automatik di tapak biokeselamatan."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Disable auto-add countries"
msgstr "Lumpuhkan negara tambah automatik"

#: src/Form/ScbdFieldSettingsForm.php
msgid "When unchecked (default), countries from bioland.settings will automatically be added to the field."
msgstr "Apabila tidak ditandai (lalai), negara dari bioland.settings akan ditambah secara automatik ke medan."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Configuration"
msgstr "Konfigurasi Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "All domains are available. Configure their display order below."
msgstr "Semua domain boleh didapati. Konfigurasikan susunan paparan mereka di bawah."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Available Domains"
msgstr "Domain Tersedia"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Reference list of all domain keys and their display names."
msgstr "Senarai rujukan semua kunci domain dan nama paparan mereka."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Domain Order"
msgstr "Perintah Domain"

#: src/Form/ScbdFieldSettingsForm.php
msgid "Enter one domain ID per line to specify display order. All listed domains will be available."
msgstr "Masukkan satu ID domain setiap baris untuk menentukan susunan paparan. Semua domain yang disenaraikan akan tersedia."

#: src/Form/ScbdFieldSettingsForm.php
msgid "Invalid domain ID: @domain"
msgstr "ID domain tidak sah: @domain"

