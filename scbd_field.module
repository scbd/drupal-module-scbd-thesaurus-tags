<?php

/**
 * @file
 * SCBD thesaurus field.
 */

/**
 * @defgroup scbd_field
 * @{
 * Examples using Field Types API.
 *
 * Providing a field requires:
 * - Defining an entity field item. Entity field items are typed data objects
 *   containing the field values.
 *   - Drupal\scbd_field\Plugin\Field\FieldType\ScbdFieldThesaurus
 * - Defining a field type schema at config/schema/[module_name].schema.yml
 *   - config/schema/scbd_field.schema.yml
 * - One or more widgets specifying how the field appears in edit forms
 *   - Drupal\scbd_field\Plugin\Field\ScbdThesaurusWidget
 * - One or more formatters specifying how the field appears in displayed
 *   entities
 *   - Drupal\scbd_field\Plugin\FieldFormatter\SimpleTextFormatter
 *
 * @see field_types
 * @see field
 * @see schemaapi
 *
 * @} End of "defgroup scbd_field".
 */

/**
 * Implements hook_page_attachments().
 */
function scbd_field_page_attachments(array &$attachments) {
  $countries = \Drupal::config('scbd_field.settings')->get('countries');
  $current_locale = \Drupal::languageManager()->getCurrentLanguage()->getId();
  $available_locales = \Drupal::service('language_manager')->getLanguages();

  $attachments['#attached']['drupalSettings']['scbd_field'] = [
    'countries' => $countries,
    'locale' => $current_locale,
    'locales' => array_keys($available_locales), // Add available locales
  ];
}

/**
 * Implements hook_entity_insert().
 */
function scbd_field_entity_insert(Drupal\Core\Entity\EntityInterface $entity) {
  // Only process content entities.
  if (!$entity instanceof \Drupal\Core\Entity\ContentEntityInterface) {
    return;
  }
  
  // Use the translation manager service to handle translation creation.
  \Drupal::service('scbd_field.translation_manager')->createTranslations($entity, 'insert');
}

/**
 * Implements hook_entity_update().
 */
function scbd_field_entity_update(Drupal\Core\Entity\EntityInterface $entity) {
  // Only process content entities.
  if (!$entity instanceof \Drupal\Core\Entity\ContentEntityInterface) {
    return;
  }
  
  // Use the translation manager service to handle translation creation.
  \Drupal::service('scbd_field.translation_manager')->createTranslations($entity, 'update');
}

/**
 * Helper function to check if an entity has SCBD thesaurus fields.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to check.
 *
 * @return bool
 *   TRUE if the entity has SCBD fields, FALSE otherwise.
 */
function scbd_field_entity_has_scbd_fields(Drupal\Core\Entity\ContentEntityInterface $entity) {
  foreach ($entity->getFieldDefinitions() as $field_definition) {
    if ($field_definition->getType() === 'scbd_field_thesaurus') {
      return TRUE;
    }
  }
  return FALSE;
}

/**
 * Helper function to get SCBD field values from an entity.
 *
 * @param \Drupal\Core\Entity\ContentEntityInterface $entity
 *   The entity to get values from.
 *
 * @return array
 *   Array of field values keyed by field name.
 */
function scbd_field_get_scbd_field_values(Drupal\Core\Entity\ContentEntityInterface $entity) {
  $values = [];
  
  foreach ($entity->getFieldDefinitions() as $field_name => $field_definition) {
    if ($field_definition->getType() === 'scbd_field_thesaurus') {
      $field_value = $entity->get($field_name)->getValue();
      if (!empty($field_value)) {
        $values[$field_name] = $field_value;
      }
    }
  }
  
  return $values;
}
